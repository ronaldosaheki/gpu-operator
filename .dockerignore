# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore all files which are not go type
!**/*.go
!**/*.mod
!**/*.sum

# Allow required directories and files for build
!assets/
!manifests/
!validator/
!hack/must-gather.sh
!deployments/gpu-operator/crds/
!deployments/gpu-operator/charts/node-feature-discovery/crds/
!LICENSE
